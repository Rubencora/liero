# OpenLiero environment variables
# Copy this file to .env and fill in your values

# WebSocket relay server URL (used by the browser client for online multiplayer)
# Default points to the production relay server
RELAY_WSS=wss://liero.byruben.io/relay/

# Relay server TCP and WebSocket ports (used when running liero-relay locally)
RELAY_TCP_PORT=7777
RELAY_WS_PORT=7778
