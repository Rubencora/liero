FROM rust:1.78-slim AS builder
WORKDIR /build
COPY . .
RUN cargo build --release --manifest-path Cargo.toml -p liero-relay

FROM debian:bookworm-slim
COPY --from=builder /build/target/release/liero-relay /usr/local/bin/liero-relay
EXPOSE 7777 7778
CMD ["liero-relay", "--tcp-port", "7777", "--ws-port", "7778"]
